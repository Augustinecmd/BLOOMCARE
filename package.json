{
    "name": "bloomcare-wrapper",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node run-dev.js",
        "dev:web": "npm --prefix BLOOMCARE-main run dev",
        "dev:api": "python server/payment_api.py",
        "start": "npm --prefix BLOOMCARE-main start",
        "build": "npm --prefix BLOOMCARE-main run build",
        "verify:firebase": "node scripts/verify-firebase-config.mjs",
        "demo": "node scripts/demo.mjs",
        "test": "node scripts/verify-firebase-config.mjs && node --test tests/*.test.mjs && python -m unittest tests.test_payment_api"
    },
    "dependencies": {
        "expo": "^57.0.18"
    }
}
