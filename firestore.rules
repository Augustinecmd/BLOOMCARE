rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return isSignedIn() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : null;
    }
    
    function hasRole(role) {
      return isSignedIn() && (
        request.auth.token.role == role || 
        getUserData().role == role
      );
    }
    
    function isStaff() {
      return isSignedIn() && (
        hasRole('admin') || 
        hasRole('developer') ||
        hasRole('pharmacist') || 
        hasRole('assistant_pharmacist') ||
        hasRole('pharmacyAssistant') || 
        hasRole('delivery_person') ||
        hasRole('deliveryStaff')
      );
    }

    function isDeveloper() {
      return isSignedIn() && (hasRole('developer') || request.auth.token.role == 'developer');
    }

    function isAdmin() {
      return isSignedIn() && (hasRole('admin') || hasRole('developer'));
    }

    function isPharmacist() {
      return isSignedIn() && (hasRole('pharmacist') || hasRole('admin') || hasRole('developer'));
    }

    // 1. User Profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create: if isSignedIn() && (
        (request.auth.uid == userId && (!('role' in request.resource.data) || request.resource.data.role == 'customer') && (!('status' in request.resource.data) || request.resource.data.status == 'active')) || 
        isAdmin() || isDeveloper()
      );
      allow update: if (
        isOwner(userId) && 
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
        (!('status' in request.resource.data) || request.resource.data.status == resource.data.status) &&
        (!('permissions' in request.resource.data) || request.resource.data.permissions == resource.data.permissions)
      ) || isAdmin() || isDeveloper();
      allow delete: if isAdmin() || isDeveloper();
    }

    // 2. Pharmacy Products (Public Catalog)
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    // 3. Pharmacy Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // 4. Pharmacy Orders (Authenticated Customers & Staff Only)
    match /orders/{orderId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // 5. Prescriptions (Authenticated Patient & Pharmacists Only)
    match /prescriptions/{presId} {
      allow read: if isPharmacist() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow update: if isPharmacist();
      allow delete: if isAdmin();
    }

    // 6. Pharmacist Consultations
    match /consultations/{consultId} {
      allow read: if isPharmacist() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow update: if isPharmacist() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // 7. Medicine Refill Requests
    match /refills/{refillId} {
      allow read: if isPharmacist() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow update: if isPharmacist();
      allow delete: if isAdmin();
    }

    // 8. Inventory Logs
    match /inventoryLogs/{logId} {
      allow read, write: if isStaff();
    }

    // 9. Deliveries
    match /deliveries/{deliveryId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow write: if isStaff();
    }

    // 10. Payments
    match /payments/{paymentId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow write: if isStaff();
    }

    // 11. Notifications
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.role == getUserData().role);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, delete: if isStaff();
    }

    // 12. Public Settings
    match /systemSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 13. Staff Action Audit Logs
    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow create: if isStaff();
      allow update, delete: if false; // Immutable audit logs
    }

    // 14. Delivery Customer Chat Conversations & Messages
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.deliveryManId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.customerId == request.auth.uid ||
        request.resource.data.deliveryManId == request.auth.uid ||
        isStaff()
      );
      allow update: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.deliveryManId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.deliveryManId == request.auth.uid ||
          isAdmin()
        );
        allow create: if isSignedIn() && (
          (get(/databases/$(database)/documents/conversations/$(conversationId)).data.customerId == request.auth.uid && request.resource.data.senderId == request.auth.uid) ||
          (get(/databases/$(database)/documents/conversations/$(conversationId)).data.deliveryManId == request.auth.uid && request.resource.data.senderId == request.auth.uid) ||
          isAdmin()
        );
        allow update: if isSignedIn() && (
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.deliveryManId == request.auth.uid
        );
        allow delete: if isAdmin();
      }
    }
  }
}

