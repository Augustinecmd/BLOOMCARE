{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run CLI Demo & Diagnostics (Terminal Only)",
      "type": "shell",
      "command": "node scripts/demo.mjs",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      }
    },
    {
      "label": "Run All Automated Tests",
      "type": "shell",
      "command": "npm.cmd test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      }
    },
    {
      "label": "Start BloomCare (Full Stack: Web + API)",
      "type": "shell",
      "command": "node run-dev.js",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting BloomCare web app",
          "endsPattern": "ready in|Local:"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      }
    }
  ]
}
