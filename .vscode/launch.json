{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "▶ Run BloomCare (Web + Payment API)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/run-dev.js",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "▶ Run & Debug Web App in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}/BLOOMCARE-main"
    },
    {
      "name": "▶ Run & Debug Web App in Edge",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}/BLOOMCARE-main"
    },
    {
      "name": "▶ Debug Payment API (Python)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/server/payment_api.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "▶ Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    }
  ]
}