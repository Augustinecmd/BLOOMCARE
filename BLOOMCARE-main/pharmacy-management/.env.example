# PostgreSQL
POSTGRES_DB=pharmacy
POSTGRES_USER=pharmacy_app
POSTGRES_PASSWORD=change_this_for_local_development
DATABASE_URL=postgresql+psycopg://pharmacy_app:change_this_for_local_development@db:5432/pharmacy

# API security — generate a strong, unique value for every environment
JWT_SECRET_KEY=replace_with_a_secure_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
